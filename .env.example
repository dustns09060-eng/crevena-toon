# Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI API keys
# 현재 스토리보드·분석·캡션 기본 구현은 Gemini를 사용합니다.
GEMINI_API_KEY=
# OpenAI 이미지 생성기를 선택할 때만 필요합니다.
OPENAI_API_KEY=

# Provider 선택 (선택 — 비워두면 코드의 기본값 사용)
# CHARACTER_ANALYZER_ID=gemini
# STORYBOARD_PROVIDER_ID=gemini
# CAPTION_PROVIDER_ID=gemini
# IMAGE_PROVIDER_ID=gemini

# 모델 지정 (선택)
# GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# GEMINI_STORY_MODEL=gemini-3.6-flash
# GEMINI_CAPTION_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# 이미지 출력 설정 (선택)
# PANEL_IMAGE_ASPECT_RATIO=1:1
# FINAL_IMAGE_ASPECT_RATIO=4:5
# FINAL_IMAGE_SIZE=1080
# CREVENA_TOON_STYLE_ID=
